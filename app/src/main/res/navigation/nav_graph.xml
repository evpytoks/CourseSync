<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="ru.katevpy.coursesync.login.LoginFragment"
        android:label="Login">

        <action
            android:id="@+id/action_loginFragment_to_coursesListFragment"
            app:destination="@id/coursesListFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/groupsFragment"
        android:name="ru.katevpy.coursesync.groups.GroupsFragment"
        android:label="Группа" />

    <fragment
        android:id="@+id/coursesListFragment"
        android:name="ru.katevpy.coursesync.courses.CoursesListFragment"
        android:label="Курсы">

        <!-- Переход в экран конкретного курса -->
        <action
            android:id="@+id/action_coursesListFragment_to_courseFragment"
            app:destination="@id/courseFragment" />
    </fragment>

    <fragment
        android:id="@+id/calendarFragment"
        android:name="ru.katevpy.coursesync.calendar.CalendarFragment"
        android:label="Календарь" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="ru.katevpy.coursesync.settings.SettingsFragment"
        android:label="Настройки" />

    <!-- DETAIL SCREEN -->
    <fragment
        android:id="@+id/courseFragment"
        android:name="ru.katevpy.coursesync.course.CourseFragment"
        android:label="Курс">

        <!-- Аргумент, чтобы передавать courseId -->
        <argument
            android:name="courseId"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

</navigation>
