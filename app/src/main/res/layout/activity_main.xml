<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="@dimen/elevation_toolbar"
        app:title="CourseSync"
        app:titleTextColor="?attr/colorOnSurface"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:minHeight="?attr/actionBarSize">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="?attr/actionBarSize">

                <ImageButton
                    android:id="@+id/btnEditCourse"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="@dimen/toolbar_icon_margin_start"
                    android:background="@drawable/bg_toolbar_action_add"
                    android:contentDescription="@string/edit_course"
                    android:padding="@dimen/grid_1"
                    android:src="@drawable/ic_edit_toolbar"
                    android:visibility="gone"
                    app:tint="?attr/colorPrimary" />

                <ImageButton
                    android:id="@+id/btnToolbarCreate"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="@dimen/toolbar_icon_margin_start"
                    android:background="@drawable/bg_toolbar_action_add"
                    android:contentDescription="@string/add_content"
                    android:padding="@dimen/grid_1"
                    android:src="@drawable/ic_add"
                    android:visibility="gone"
                    app:tint="?attr/colorPrimary" />

                <ImageButton
                    android:id="@+id/btnEditEvent"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="@dimen/toolbar_icon_margin_start"
                    android:background="@drawable/bg_toolbar_action_add"
                    android:contentDescription="@string/event_edit"
                    android:padding="@dimen/grid_1"
                    android:src="@drawable/ic_edit_toolbar"
                    android:visibility="gone"
                    app:tint="?attr/colorPrimary" />

                <ImageButton
                    android:id="@+id/btnToolbarGroup"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="@dimen/toolbar_icon_margin_start"
                    android:background="@drawable/bg_toolbar_action_add"
                    android:contentDescription="@string/toolbar_group_menu"
                    android:padding="@dimen/grid_1"
                    android:src="@drawable/ic_add"
                    android:visibility="gone"
                    app:tint="?attr/colorPrimary" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <LinearLayout
                    android:id="@+id/groupIndicatorContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/grid_1"
                    android:paddingEnd="@dimen/grid_2">

                    <ImageView
                        android:layout_width="@dimen/toolbar_group_indicator_icon_size"
                        android:layout_height="@dimen/toolbar_group_indicator_icon_size"
                        android:layout_marginEnd="@dimen/toolbar_group_indicator_icon_text_gap"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_nav_groups"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvGroupIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:maxWidth="@dimen/toolbar_group_indicator_max_width"
                        android:text="нет группы"
                        android:textAppearance="?attr/textAppearanceBodySmall" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:theme="@style/ThemeOverlay.CourseSync.BottomNavigation"
        app:elevation="@dimen/elevation_bottom_nav"
        app:menu="@menu/bottom_menu"
        app:labelVisibilityMode="selected"
        app:itemHorizontalTranslationEnabled="false"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
