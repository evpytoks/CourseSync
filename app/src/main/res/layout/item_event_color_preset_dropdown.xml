<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/list_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/grid_2"
    android:paddingTop="@dimen/grid_1"
    android:paddingEnd="@dimen/grid_2"
    android:paddingBottom="@dimen/grid_1">

    <View
        android:id="@+id/presetSwatch"
        android:layout_width="@dimen/settings_event_color_preset_dropdown_swatch_size"
        android:layout_height="@dimen/settings_event_color_preset_dropdown_swatch_size"
        android:layout_marginEnd="@dimen/grid_2"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/presetHex"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:textAppearance="?attr/textAppearanceBodyLarge" />
</LinearLayout>
