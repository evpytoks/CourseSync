<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/grid_3"
        android:paddingTop="@dimen/grid_2"
        android:paddingEnd="@dimen/grid_3"
        android:paddingBottom="@dimen/grid_2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/grading_cumulative_elements_label"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <ImageButton
                android:id="@+id/btnAddCumulativeElement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/grading_cumulative_add_element"
                android:padding="@dimen/grid_1"
                android:src="@drawable/ic_add" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCumulativeElements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/grid_1"
            app:chipSpacingHorizontal="@dimen/grid_1"
            app:chipSpacingVertical="@dimen/grid_1"
            app:singleLine="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/grid_2"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/grading_cumulative_block"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/editCumulativeBlockLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="@dimen/grading_cumulative_number_field_size"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/grid_2"
                app:errorEnabled="false"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editCumulativeBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal|numberSigned"
                    android:maxLength="5"
                    android:maxLines="1"
                    android:minHeight="@dimen/grading_cumulative_number_field_size"
                    android:textAlignment="center" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/textCumulativeBlockError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/grid_1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/grid_2"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/grading_cumulative_automatic"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/editCumulativeAutomaticLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="@dimen/grading_cumulative_number_field_size"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/grid_2"
                app:errorEnabled="false"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editCumulativeAutomatic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal|numberSigned"
                    android:maxLength="5"
                    android:maxLines="1"
                    android:minHeight="@dimen/grading_cumulative_number_field_size"
                    android:textAlignment="center" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/textCumulativeAutomaticError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/grid_1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveCumulativeGrade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/grid_3"
            android:text="@string/grading_cumulative_save" />
    </LinearLayout>
</ScrollView>
