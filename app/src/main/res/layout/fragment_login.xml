<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingEnd="@dimen/screen_padding_horizontal"
    tools:context=".login.LoginFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/login_above_bottom_nav"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/card_content_padding">

        <EditText
            android:id="@+id/email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:hint="Введите корпоративную почту..."
            android:inputType="textEmailAddress"
            android:minHeight="@dimen/login_submit_min_height"
            android:paddingStart="@dimen/grid_2"
            android:paddingEnd="@dimen/grid_2"
            android:singleLine="true"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <EditText
            android:id="@+id/code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_field_spacing"
            android:gravity="center_vertical"
            android:hint="Введите код подтверждения..."
            android:inputType="textEmailAddress"
            android:minHeight="@dimen/login_submit_min_height"
            android:paddingStart="@dimen/grid_2"
            android:paddingEnd="@dimen/grid_2"
            android:singleLine="true"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:visibility="invisible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_code_button_spacing"
            android:minHeight="@dimen/login_submit_min_height"
            android:text="send code"
            android:textAppearance="?attr/textAppearanceTitleMedium" />
    </LinearLayout>
</FrameLayout>
