<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.CourseSync.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.28</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.CourseSync.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="TextAppearance.CourseSync.BodyEmphasized" parent="TextAppearance.CourseSync.Body">
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
    </style>

    <style name="TextAppearance.CourseSync.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.38</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.CourseSync.CaptionEmphasized" parent="TextAppearance.CourseSync.Caption">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.CourseSync.ContactValue" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.CourseSync.ContactTypeCaption" parent="TextAppearance.CourseSync.Caption">
        <item name="android:letterSpacing">0.01</item>
    </style>
</resources>
