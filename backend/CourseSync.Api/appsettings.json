{
  "ConnectionStrings": {
    "AppDb": "Host=localhost;Port=5432;Database=coursesync;Username=user;Password=12345"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "CourseSync",
    "Audience": "CourseSyncMobile",
    "Key": "SUPER_LONG_SECRET_KEY_CHANGE_ME_1234567890",
    "AccessTokenMinutes": 60
  },
  "AuthCode": {
    "CodeTtlSeconds": 300,
    "SendCooldownSeconds": 60,
    "MaxAttempts": 3,
    "LockoutSeconds": 600,
    "HashKey": "SUPER_LONG_SECRET_KEY_CHANGE_ME_AUTHCODE_1234567890"
  },
  "AuthTokens": {
    "RefreshTokenTtlDays": 30,
    "RefreshTokenHashKey": "SUPER_LONG_SECRET_KEY_CHANGE_ME_REFRESHTOKEN_1234567890"
  },
  "Smtp": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "Security": "StartTls",
    "Username": "",
    "Password": "",
    "FromEmail": "noreply.coursesync",
    "FromName": "CourseSync",
    "TimeoutMs": 10000
  },
  "RateLimit": {
    "GlobalPermitLimit": 100,
    "GlobalWindowMinutes": 1,
    "Endpoints": {
      "auth/send-code": { "PermitLimit": 100, "WindowMinutes": 1 },
      "auth/login": { "PermitLimit": 100, "WindowMinutes": 1 },
      "auth/refresh": { "PermitLimit": 100, "WindowMinutes": 1 },
      "group/create": { "PermitLimit": 100, "WindowMinutes": 1 },
      "group/list": { "PermitLimit": 100, "WindowMinutes": 1 },
      "group/join": { "PermitLimit": 100, "WindowMinutes": 1 },
      "group/{id}/change": { "PermitLimit": 100, "WindowMinutes": 1 },
      "group/{id}/choose": { "PermitLimit": 100, "WindowMinutes": 1 }
    }
  }
}
